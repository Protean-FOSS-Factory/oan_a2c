            "item": [
                {
                    "name": "Get Consent Data (After OTP Verified)",
                    "description": "Returns the farmer's consent status and profile data fetched from OpenG2P after OTP verification. Used to display the green 'Consent Verified' badge and pre-fill farmer fields in the UI. Consent & OTP flow (Send OTP, Verify OTP) is in consent_api_postman_collection.json.",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwt_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"application_id\": \"{{application_id}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/method/oan_a2c.api.loan_app_api.get_consent_data",
                            "host": ["{{base_url}}"],
                            "path": ["api", "method", "oan_a2c.api.loan_app_api.get_consent_data"]
                        }
                    }
                }
            ]
        },
